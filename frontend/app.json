{
  "expo": {
    "name": "bolt-expo-nativewind",
    "slug": "bolt-expo-nativewind",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "NepVoice needs your camera to photograph documents and read them aloud to you."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "NepVoice needs your microphone so you can ask a spoken follow-up question."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
